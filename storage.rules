rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 前台需要公開讀取圖片與影片
    match /{allPaths=**} {
      allow read: if true;
    }
    // 只有管理員帳號可以上傳（200MB 以內的圖片或影片）
    match /uploads/{rest=**} {
      allow write: if request.auth != null
        && request.auth.token.email == 'harrylinjiayoufilm@gmail.com'
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
